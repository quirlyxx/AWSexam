@model AWSexam.Models.CartVm
@{
    ViewData["Title"] = "Кошик";
}
<section class="page-section"><div class="container">
    <div class="page-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> NORTH / ТВОЇ ВИБОРИ</div><h1>Кошик<span class="heading-period">.</span></h1><p class="page-intro">Усе, що ти відібрав, в одному місці.</p></div><a asp-controller="Products" asp-action="Index" class="text-action">Продовжити покупки <span>↗</span></a></div>
    @if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
    @if (!Model.Lines.Any())
    {
        <div class="empty-state cart-empty"><div class="empty-icon">↗</div><h2>Поки нічого зайвого.</h2><p>Твій кошик порожній. Саме час знайти щось потрібне.</p><a asp-controller="Products" asp-action="Index" class="btn btn-ink">Перейти до каталогу <span>↗</span></a></div>
    }
    else
    {
        <div class="cart-layout"><div class="cart-items">
        @foreach (var line in Model.Lines)
        {
            <div class="cart-item">
                <div class="cart-item-art"><span>N<span>/</span></span></div>
                <div class="cart-item-main"><a asp-controller="Products" asp-action="Details" asp-route-id="@line.Product.Id" class="cart-product-name">@line.Product.Name</a><span class="cart-category">@line.Product.Category</span><span class="cart-unit-price">@line.Product.Price.ToString("0.00") грн / шт.</span></div>
                <form asp-action="Update" method="post" class="quantity-form"><input type="hidden" name="id" value="@line.Product.Id" /><label for="qty-@line.Product.Id">К-сть</label><input id="qty-@line.Product.Id" type="number" name="quantity" value="@line.Quantity" min="0" max="@line.Product.Quantity" class="form-control" /><button type="submit" class="quantity-update">Оновити</button></form>
                <div class="cart-item-total"><strong>@line.Subtotal.ToString("0.00")</strong><small>грн</small><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@line.Product.Id" /><button type="submit" class="remove-link">Видалити ×</button></form></div>
            </div>
        }
        </div><aside class="cart-summary"><div class="eyebrow"><span class="eyebrow-line"></span> ПІДСУМОК</div><div class="summary-row"><span>Позицій</span><strong>@Model.Lines.Sum(x => x.Quantity)</strong></div><div class="summary-row"><span>Доставка</span><strong>За тарифами</strong></div><div class="summary-total"><span>Разом</span><strong>@Model.Total.ToString("0.00") <small>грн</small></strong></div><a asp-controller="Orders" asp-action="Checkout" class="btn btn-ink checkout-button">Оформити замовлення <span>↗</span></a><p class="summary-note">Перевір кількість товарів перед оформленням.</p></aside></div>
    }
</div></section>
