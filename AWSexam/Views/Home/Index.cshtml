@{
    ViewData["Title"] = "Техніка без зайвого";
}
<section class="hero-wrap">
    <div class="container">
        <div class="hero">
            <div class="hero-copy">
                <div class="eyebrow"><span class="eyebrow-line"></span> РЕЧІ, ЯКІ ПРАЦЮЮТЬ НА ТЕБЕ</div>
                <h1>Технології.<br><em>Без зайвого.</em></h1>
                <p class="hero-description">Добірка техніки для роботи, відпочинку та всього, що між ними. Чітко по суті — від вибору до доставки.</p>
                <div class="hero-actions">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-ink">Переглянути каталог <span>↗</span></a>
                    <span class="hero-note">Знайди свою наступну річ.</span>
                </div>
                <div class="hero-bottom"><span>01 — 03</span><span class="hero-rule"></span><span>ПРОДУМАНИЙ ВИБІР</span></div>
            </div>
            <div class="hero-art">
                <div class="art-label art-label-top">OBJECTS<br>FOR EVERYDAY</div>
                <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
                <div class="art-disc"></div>
                <div class="art-product">
                    <div class="product-shadow"></div>
                    <div class="headphone headband"></div>
                    <div class="headphone ear-left"></div><div class="headphone ear-right"></div>
                    <div class="ear-pad pad-left"></div><div class="ear-pad pad-right"></div>
                    <div class="headphone-detail"></div>
                </div>
                <div class="art-index"><span>№</span> 001</div>
                <div class="art-label art-label-bottom">DESIGN THAT<br>MAKES SENSE.</div>
                <div class="art-sticker">GOOD<br>CHOICE<span>✳</span></div>
            </div>
        </div>
        <div class="benefit-row">
            <div class="benefit"><span class="benefit-number">01</span><div><strong>Тільки потрібне</strong><small>Жодного інформаційного шуму</small></div></div>
            <div class="benefit"><span class="benefit-number">02</span><div><strong>Все по поличках</strong><small>Зрозумілі ціни та характеристики</small></div></div>
            <div class="benefit"><span class="benefit-number">03</span><div><strong>Простий вибір</strong><small>Знайти своє — без квестів</small></div></div>
            <a asp-controller="Products" asp-action="Index" class="benefit-cta">До покупок <span>↗</span></a>
        </div>
    </div>
</section>
